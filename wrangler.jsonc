{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crosscue",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "account_id": "9cd9c1ea1ed60cdf5d327f20d9987fcf",
  "d1_databases": [{"binding":"DB","database_name":"crosscue-state","database_id":"808b281c-264e-41ee-8354-dc5f2a48abab"}],
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true},
  "vars": {"QLOO_BASE_URL": "https://hackathon.api.qloo.com", "SOURCE_REVISION": "pending-tested-release"},
  "triggers": {"crons": ["17 * * * *"]},
  "observability": {"enabled": false}
}
